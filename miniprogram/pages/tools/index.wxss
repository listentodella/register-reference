page {
  padding-bottom: 40rpx;
}

.page {
  box-sizing: border-box;
}

/* ---------- 分段控件 ---------- */

.control-row {
  padding: 20rpx 24rpx 0;
}

.segmented {
  display: flex;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  overflow: hidden;
}

.seg-item {
  flex: 1 1 0;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--muted);
  background: var(--control-bg);
}

.seg-item + .seg-item {
  border-left: 1rpx solid var(--line);
}

.seg-item.active {
  color: var(--accent-contrast);
  background: var(--accent);
}

/* ---------- 数值输入 ---------- */

.input-row {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx 0;
}

.input-label {
  flex: 0 0 auto;
  width: 72rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
}

.input-box {
  flex: 1 1 auto;
  min-width: 0;
  height: 76rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: var(--control-bg);
  color: var(--text);
  font-size: 28rpx;
}

.input-box.invalid {
  border-color: var(--red);
  background: var(--red-soft);
  color: var(--red-ink);
}

.status {
  margin: 20rpx 24rpx 24rpx;
  padding: 14rpx 18rpx;
  border-radius: 10rpx;
  background: var(--surface-neutral);
  font-size: 24rpx;
  color: var(--subtle-text);
}

.status.error {
  background: var(--red-soft);
  color: var(--red-ink);
}

/* ---------- 位域组合 ---------- */

.composer-hint {
  padding: 16rpx 24rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

.composer {
  margin-top: 16rpx;
  white-space: nowrap;
}

.composer-inner {
  padding: 0 0 20rpx 0;
}

.byte-row {
  display: flex;
  padding: 0 0 6rpx 0;
}

.byte {
  flex: 0 0 auto;
  text-align: center;
  font-size: 22rpx;
  color: var(--muted);
  border-right: 1rpx solid var(--line);
}

.bit-row {
  display: flex;
  border-top: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  background: var(--panel-soft);
}

.bit-cell {
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  border-right: 1rpx solid var(--line);
}

.bit-index {
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 20rpx;
  color: var(--muted);
  background: var(--surface-neutral);
}

.bit-value {
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 26rpx;
  font-family: var(--mono);
  color: var(--text-soft);
}

.bit-cell.set .bit-value {
  color: var(--accent-contrast);
  background: var(--accent);
}

.bit-cell.active .bit-index {
  color: var(--accent-contrast);
  background: var(--accent-strong);
}

.bit-cell.preview .bit-index {
  background: var(--amber);
  color: var(--amber-ink);
}

.track {
  margin-top: 12rpx;
}

.track-label {
  display: block;
  padding: 0 0 6rpx 0;
  font-size: 20rpx;
  color: var(--muted);
}

.track-row {
  display: flex;
  border-top: 1rpx solid var(--line);
}

.cell {
  flex: 0 0 auto;
  box-sizing: border-box;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 8rpx;
  border-right: 1rpx solid var(--line);
  border-bottom: 1rpx solid var(--line);
  text-align: center;
  font-size: 24rpx;
  overflow: hidden;
}

.cell.range {
  color: var(--accent-ink);
  background: var(--accent-soft);
}

.cell.range.narrow {
  font-size: 18rpx;
}

.cell.range.active {
  color: var(--accent-contrast);
  background: var(--accent);
}

.cell.input {
  color: var(--text);
  background: var(--control-bg);
}

.cell.input.invalid {
  color: var(--red-ink);
  background: var(--red-soft);
}

/* ---------- 常用操作 ---------- */

.operation-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 0;
}

.operation {
  flex: 0 0 auto;
  margin: 0 16rpx 16rpx 0;
  padding: 18rpx 28rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: var(--control-bg);
  font-size: 26rpx;
  color: var(--text);
}

.shift-row {
  display: flex;
  align-items: center;
  padding: 8rpx 24rpx 0;
}

.shift-command {
  flex: 0 0 auto;
  padding: 18rpx 28rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: var(--control-bg);
  font-size: 26rpx;
  color: var(--text);
}

.stepper {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.stepper-input {
  width: 120rpx;
  height: 68rpx;
  padding: 0 12rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: var(--control-bg);
  color: var(--text);
  font-size: 26rpx;
  text-align: center;
}

.stepper-buttons {
  display: flex;
  flex-direction: column;
  margin-left: 8rpx;
}

.stepper-button {
  width: 56rpx;
  height: 34rpx;
  line-height: 32rpx;
  text-align: center;
  border: 1rpx solid var(--line-strong);
  background: var(--control-bg);
  font-size: 22rpx;
  color: var(--text);
}

.stepper-button:first-child {
  border-radius: 8rpx 8rpx 0 0;
}

.stepper-button:last-child {
  border-radius: 0 0 8rpx 8rpx;
  border-top: none;
}

.shift-unit {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* ---------- 计算器 ---------- */

.calculator-form {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  padding: 0 16rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 10rpx;
  background: var(--control-bg);
}

.calculator-prompt {
  flex: 0 0 auto;
  font-size: 26rpx;
  color: var(--accent);
}

.calculator-input {
  flex: 1 1 auto;
  min-width: 0;
  height: 80rpx;
  padding: 0 12rpx;
  font-size: 28rpx;
  color: var(--text);
}

.calculator-submit {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  background: var(--accent);
  color: var(--accent-contrast);
  font-size: 26rpx;
}

.calculator-hint {
  margin: 14rpx 24rpx 0;
  font-size: 22rpx;
  color: var(--muted);
}

.history {
  margin: 20rpx 24rpx 24rpx;
}

.history-entry {
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.history-expression {
  font-size: 26rpx;
  color: var(--text);
}

.history-error {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--red-ink);
}

.history-result {
  display: flex;
  margin-top: 8rpx;
}

.history-value {
  display: flex;
  align-items: baseline;
  margin-right: 32rpx;
  font-size: 28rpx;
  color: var(--text);
}

.history-base {
  margin-right: 10rpx;
  font-size: 20rpx;
  color: var(--muted);
}

.history-empty {
  margin: 20rpx 24rpx 24rpx;
  font-size: 24rpx;
  color: var(--muted);
}
