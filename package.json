{
  "name": "register-reference",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "data:build": "node tools/build-data.mjs",
    "workers:build": "node tools/build-search-worker-inline.mjs && node tools/build-import-worker-inline.mjs",
    "web:build": "npm run data:build && npm run workers:build && node tools/build-web.mjs",
    "arm:import": "node tools/import-arm-mrs.mjs",
    "arm:cmsis-import": "node tools/import-arm-cmsis.mjs",
    "riscv:import": "node tools/import-riscv-csr.mjs",
    "test:arm-import": "node tools/test-arm-mrs-importer.mjs && node tools/test-arm-cmsis-importer.mjs",
    "test:arm-cmsis-import": "node tools/test-arm-cmsis-importer.mjs",
    "test:riscv-import": "node tools/test-riscv-csr-importer.mjs",
    "test:web": "npm run web:build && node tools/test-viewer.mjs",
    "test:web:webkit": "npm run web:build && cross-env BROWSER_ENGINE=webkit node tools/test-viewer.mjs",
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build -- --locked && node tools/package-portable.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@xmldom/xmldom": "^0.9.11",
    "cross-env": "10.1.0",
    "playwright": "1.62.1",
    "tar": "^7.5.22",
    "yaml": "2.9.0"
  },
  "dependencies": {
    "fuse.js": "^7.1.0",
    "jsep": "1.4.0",
    "lucide": "1.30.0"
  }
}
