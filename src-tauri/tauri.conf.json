{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "寄存器速查工具",
  "version": "0.1.0",
  "identifier": "com.leo.registerreference",
  "build": {
    "beforeDevCommand": "npm run web:build",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "寄存器速查工具",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Reference",
    "shortDescription": "本地芯片寄存器资料库",
    "longDescription": "用于导入、分类、检索和标注芯片寄存器 YAML 的本地桌面工具。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
